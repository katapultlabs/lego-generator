{
  "name": "lego-generator-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ../../crates/brick-wasm --target web --release --out-dir ../../apps/web/src/wasm",
    "dev": "pnpm wasm && op run --env-file=../../.env -- vite",
    "dev:offline": "pnpm wasm && vite",
    "build": "pnpm wasm && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
